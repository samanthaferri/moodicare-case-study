{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "MoodiCare case study design tokens. TWO tiers: primitive (raw values) and semantic (intent aliases, referenced as {group.path}). Mirrors assets/css/tokens.css. Only Figma-representable values live here: fluid type (clamp), gradients and layered shadows stay in the web layer and are noted below with their resolved max values / style targets. Groups map to Figma Variable collections + styles — see design-system.md.",

  "color": {
    "primitive": {
      "white": { "$type": "color", "$value": "#ffffff" },

      "teal": {
        "700": { "$type": "color", "$value": "#32817f", "$description": "Figma Corporate/dark_primary. Accent word, links, kickers." },
        "500": { "$type": "color", "$value": "#47b2b0", "$description": "Figma Corporate/primary. The brand." },
        "200": { "$type": "color", "$value": "#c1e1e1", "$description": "Figma Corporate/light_primary. Tinted bands, tags, card hairline." },
        "100": { "$type": "color", "$value": "#e0f0f0", "$description": "Figma Grayscale/divider_light. Section-title highlighter, soft fills, chips." },
        "050": { "$type": "color", "$value": "#f4fbfa", "$description": "Softest wash. Soft card fill." },
        "frame": { "$type": "color", "$value": "#f5fafa", "$description": "Neutral frame behind screenshot strips." },
        "bright": { "$type": "color", "$value": "#7fe0dd", "$description": "Accent that stays legible on navy (dark band)." },
        "gradLite": { "$type": "color", "$value": "#7fe0d4", "$description": "Brand-gradient light stop. Used only inside color.gradient.brand." }
      },
      "navy": {
        "900": { "$type": "color", "$value": "#0f1330", "$description": "Dark-band gradient end." },
        "800": { "$type": "color", "$value": "#151938", "$description": "Headings; phone-mockup frame." },
        "700": { "$type": "color", "$value": "#1a1f46", "$description": "Figma Corporate/secondary. Strong text, dark-band base." },
        "200": { "$type": "color", "$value": "#c7ccea", "$description": "Body text on the dark band." },
        "300": { "$type": "color", "$value": "#9aa2c8", "$description": "Muted text on the dark band." }
      },
      "neutral": {
        "900": { "$type": "color", "$value": "#202020", "$description": "Long-form body copy." },
        "800": { "$type": "color", "$value": "#37383f", "$description": "Secondary copy." },
        "400": { "$type": "color", "$value": "#9b949e", "$description": "Captions / sources. Figma Grayscale/text-muted." },
        "350": { "$type": "color", "$value": "#ada7af", "$description": "Strong hairline / dashed placeholder border." },
        "200": { "$type": "color", "$value": "#e0e0e0", "$description": "Inactive marks (check 'no')." },
        "150": { "$type": "color", "$value": "#f2f1f3", "$description": "Row / section dividers; metric-grid gaps." },
        "050": { "$type": "color", "$value": "#f9fbfb", "$description": "The off-white page ground." }
      },
      "coral": {
        "500": { "$type": "color", "$value": "#ff6682", "$description": "Figma Informing/error. Journey barrier column." }
      },
      "amber": {
        "050": { "$type": "color", "$value": "#fff9ec", "$description": "Caution / honesty-note surface." },
        "200": { "$type": "color", "$value": "#f2e2b8", "$description": "Caution-note border." },
        "700": { "$type": "color", "$value": "#7a6320", "$description": "Caution-note heading." },
        "800": { "$type": "color", "$value": "#6b5a2a", "$description": "Caution-note body text." }
      },
      "slate": {
        "200": { "$type": "color", "$value": "#dfe3f0", "$description": "Phone-mockup screen backing (exception element only)." }
      },
      "overlayLight": {
        "05": { "$type": "color", "$value": "rgba(255,255,255,0.05)", "$description": "Inset card fill on dark." },
        "06": { "$type": "color", "$value": "rgba(255,255,255,0.06)", "$description": "Inset card fill on dark (deep-dive mode card)." },
        "12": { "$type": "color", "$value": "rgba(255,255,255,0.12)", "$description": "Hairline border on dark." },
        "14": { "$type": "color", "$value": "rgba(255,255,255,0.14)", "$description": "Stronger hairline on dark." },
        "35": { "$type": "color", "$value": "rgba(255,255,255,0.35)", "$description": "Empathy note folded-corner." }
      }
    },

    "semantic": {
      "text": {
        "primary": { "$type": "color", "$value": "{color.primitive.navy.800}", "$description": "Headings, primary copy on light." },
        "secondary": { "$type": "color", "$value": "{color.primitive.neutral.800}", "$description": "Supporting / card body copy." },
        "muted": { "$type": "color", "$value": "{color.primitive.neutral.400}", "$description": "Captions, sources. A11y note in design-system.md." },
        "strong": { "$type": "color", "$value": "{color.primitive.navy.700}", "$description": "Big numbers, emphatic labels." },
        "accent": { "$type": "color", "$value": "{color.primitive.teal.700}", "$description": "Accent word, links, kickers on light." },
        "onBrand": { "$type": "color", "$value": "{color.primitive.white}", "$description": "Text on a solid teal surface." },
        "onInverse": { "$type": "color", "$value": "{color.primitive.navy.200}", "$description": "Body text on the dark band." },
        "onInverseMuted": { "$type": "color", "$value": "{color.primitive.navy.300}", "$description": "Muted text on the dark band." }
      },
      "surface": {
        "page": { "$type": "color", "$value": "{color.primitive.neutral.050}" },
        "card": { "$type": "color", "$value": "{color.primitive.white}" },
        "soft": { "$type": "color", "$value": "{color.primitive.teal.100}", "$description": "Chips, card-sorting body, highlighter." },
        "softAlt": { "$type": "color", "$value": "{color.primitive.teal.050}", "$description": "Soft card fill." },
        "tinted": { "$type": "color", "$value": "{color.primitive.teal.200}", "$description": "Full-bleed tinted bands, tags, table heads." },
        "frame": { "$type": "color", "$value": "{color.primitive.teal.frame}", "$description": "Frame behind screenshots." },
        "inverse": { "$type": "color", "$value": "{color.primitive.navy.700}", "$description": "Dark band base." },
        "notice": { "$type": "color", "$value": "{color.primitive.amber.050}" },
        "insetInverse": { "$type": "color", "$value": "{color.primitive.overlayLight.06}", "$description": "Inset card on the dark band." }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{color.primitive.teal.200}", "$description": "Card hairline." },
        "divider": { "$type": "color", "$value": "{color.primitive.neutral.150}", "$description": "Row / section hairlines." },
        "strong": { "$type": "color", "$value": "{color.primitive.neutral.350}" },
        "muted": { "$type": "color", "$value": "{color.primitive.neutral.200}", "$description": "Inactive check ring." },
        "notice": { "$type": "color", "$value": "{color.primitive.amber.200}" },
        "onInverse": { "$type": "color", "$value": "{color.primitive.overlayLight.12}" },
        "onInverseStrong": { "$type": "color", "$value": "{color.primitive.overlayLight.14}" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "{color.primitive.teal.500}" },
        "primaryHover": { "$type": "color", "$value": "{color.primitive.teal.700}" },
        "link": { "$type": "color", "$value": "{color.primitive.teal.700}" },
        "linkHover": { "$type": "color", "$value": "{color.primitive.navy.700}" }
      },
      "accent": {
        "brand": { "$type": "color", "$value": "{color.primitive.teal.500}", "$description": "Markers, dividers, number segments." },
        "onInverse": { "$type": "color", "$value": "{color.primitive.teal.bright}" },
        "titleHighlight": { "$type": "color", "$value": "{color.primitive.teal.100}", "$description": "The section-title highlighter swipe." }
      },
      "focusRing": { "$type": "color", "$value": "{color.primitive.teal.500}" },
      "feedback": {
        "error": { "$type": "color", "$value": "{color.primitive.coral.500}" },
        "noticeText": { "$type": "color", "$value": "{color.primitive.amber.800}" },
        "noticeHeading": { "$type": "color", "$value": "{color.primitive.amber.700}" }
      }
    },

    "gradient": {
      "$description": "NOT Figma variables. Create as gradient / fill styles.",
      "inverse": { "$type": "gradient", "$value": "linear-gradient(160deg, {color.primitive.navy.700}, {color.primitive.navy.900})", "$description": "Dark band + posology deep-dive panel." },
      "brand": { "$type": "gradient", "$value": "linear-gradient(135deg, {color.primitive.teal.gradLite}, {color.primitive.teal.500})", "$description": "Visual-identity 'Gradient' swatch." },
      "notice": { "$type": "gradient", "$value": "linear-gradient(135deg, {color.primitive.teal.050}, {color.primitive.teal.100})", "$description": "Research-question panel." }
    }
  },

  "typography": {
    "primitive": {
      "fontFamily": {
        "poppins": { "$type": "fontFamily", "$value": "Poppins, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" }
      },
      "fontWeight": {
        "light": { "$type": "fontWeight", "$value": 300, "$description": "Cover description / type specimen only." },
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 },
        "black": { "$type": "fontWeight", "$value": 900, "$description": "Cover title only." }
      },
      "fontSize": {
        "$description": "Web uses clamp() for fluid scaling; the $value below is the DESKTOP MAX (what a Figma text style should carry). The mobile floor is in parentheses.",
        "display": { "$type": "dimension", "$value": "70px", "$description": "min 44px. Cover title." },
        "title": { "$type": "dimension", "$value": "41px", "$description": "min 32px. Section band titles." },
        "h2": { "$type": "dimension", "$value": "32px", "$description": "min 22px. Flow title, footer h2, cover tagline." },
        "h3": { "$type": "dimension", "$value": "20px", "$description": "Card titles, eyebrow, sub-heads. Not fluid." },
        "lead": { "$type": "dimension", "$value": "26px", "$description": "min 20px. Standfirst paragraphs; context stat value." },
        "body": { "$type": "dimension", "$value": "18px", "$description": "Not fluid." },
        "sm": { "$type": "dimension", "$value": "15px", "$description": "Card body, list items, table cells. Not fluid." },
        "xs": { "$type": "dimension", "$value": "13px", "$description": "Captions, sources. Not fluid." },
        "2xs": { "$type": "dimension", "$value": "11.5px", "$description": "Kickers, micro-labels. Not fluid." },
        "metric": { "$type": "dimension", "$value": "42px", "$description": "min 32px. Overview + validation big numbers." }
      },
      "lineHeight": {
        "tight": { "$type": "number", "$value": 1.15, "$description": "Display, section title, metric." },
        "snug": { "$type": "number", "$value": 1.35, "$description": "Card titles." },
        "normal": { "$type": "number", "$value": 1.5, "$description": "Dense body, table cells." },
        "relaxed": { "$type": "number", "$value": 1.65, "$description": "Running copy." }
      },
      "letterSpacing": {
        "tight": { "$type": "dimension", "$value": "-0.03em", "$description": "Big numbers, cover title." },
        "normal": { "$type": "dimension", "$value": "0" },
        "wide": { "$type": "dimension", "$value": "0.06em", "$description": "Micro badges." },
        "wider": { "$type": "dimension", "$value": "0.12em", "$description": "Kickers." }
      }
    },

    "semantic": {
      "$description": "10 roles → Figma Text styles. Each pairs a size with a weight + line-height; the section-title accent word is a Bold + text/accent override, not a separate style.",
      "display": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.black}", "fontSize": "{typography.primitive.fontSize.display}", "lineHeight": "{typography.primitive.lineHeight.tight}", "letterSpacing": "{typography.primitive.letterSpacing.tight}" } },
      "sectionTitle": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.medium}", "fontSize": "{typography.primitive.fontSize.title}", "lineHeight": "{typography.primitive.lineHeight.tight}" } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.bold}", "fontSize": "{typography.primitive.fontSize.h2}", "lineHeight": "{typography.primitive.lineHeight.tight}" } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.bold}", "fontSize": "{typography.primitive.fontSize.h3}", "lineHeight": "{typography.primitive.lineHeight.snug}" }, "$description": "Card titles. Eyebrow reuses this size at weight semibold." },
      "lead": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.regular}", "fontSize": "{typography.primitive.fontSize.lead}", "lineHeight": "{typography.primitive.lineHeight.normal}" } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.regular}", "fontSize": "{typography.primitive.fontSize.body}", "lineHeight": "{typography.primitive.lineHeight.relaxed}" } },
      "bodySmall": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.regular}", "fontSize": "{typography.primitive.fontSize.sm}", "lineHeight": "{typography.primitive.lineHeight.relaxed}" } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.regular}", "fontSize": "{typography.primitive.fontSize.xs}", "lineHeight": "{typography.primitive.lineHeight.relaxed}" }, "$description": "Colour → text/muted." },
      "kicker": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.bold}", "fontSize": "{typography.primitive.fontSize.2xs}", "lineHeight": "{typography.primitive.lineHeight.normal}", "letterSpacing": "{typography.primitive.letterSpacing.wider}", "textCase": "uppercase" } },
      "metric": { "$type": "typography", "$value": { "fontFamily": "{typography.primitive.fontFamily.poppins}", "fontWeight": "{typography.primitive.fontWeight.bold}", "fontSize": "{typography.primitive.fontSize.metric}", "lineHeight": "1", "letterSpacing": "{typography.primitive.letterSpacing.tight}" } }
    }
  },

  "spacing": {
    "$description": "4pt base. Figma → Spacing variable collection.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "sectionBlock": { "$type": "dimension", "$value": "96px", "$description": "Section band vertical padding (web: clamp 48–96px)." },
    "gutter": { "$type": "dimension", "$value": "40px", "$description": "Page side gutter (web: clamp 16–40px)." }
  },

  "radius": {
    "$description": "6 steps + 2 phone-mockup exceptions. Figma → Radius variable collection. 'round' = 50%, model as a large number + isCircle boolean.",
    "xs": { "$type": "dimension", "$value": "8px", "$description": "Small marks, inset cards." },
    "sm": { "$type": "dimension", "$value": "12px", "$description": "Chips, table cells, icons." },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Tags, metric grid, flow badge, notice card." },
    "lg": { "$type": "dimension", "$value": "24px", "$description": "Cards, panels, media frames, quote." },
    "pill": { "$type": "dimension", "$value": "999px" },
    "round": { "$type": "dimension", "$value": "9999px", "$description": "Avatars, dots, check rings. CSS uses 50%." },
    "phone": { "$type": "dimension", "$value": "44px", "$description": "EXCEPTION — phone-mockup body." },
    "phoneScreen": { "$type": "dimension", "$value": "34px", "$description": "EXCEPTION — phone-mockup screen." }
  },

  "border": {
    "width": {
      "$description": "Figma → Border width variable collection. Borders in CSS are composed from a width variable + a border/* colour; there is no combined border token.",
      "hairline": { "$type": "dimension", "$value": "1px" },
      "thin": { "$type": "dimension", "$value": "2px" },
      "thick": { "$type": "dimension", "$value": "3px" }
    }
  },

  "shadow": {
    "$description": "NOT Figma variables. Create as 3 Effect styles + 1 exception. rgb triplets: ink = 5 6 15, navy = 26 31 70, phoneInk = 39 40 45.",
    "sm": { "$type": "shadow", "$value": "0 0 2px rgba(5 6 15 / 0.02), 0 0 2px rgba(5 6 15 / 0.04), 0 2px 6px rgba(5 6 15 / 0.08)", "$description": "Cards, tags, table-cell lift, chips." },
    "card": { "$type": "shadow", "$value": "0 4px 20px rgba(26 31 70 / 0.08)", "$description": "The default card / metric-grid / comparison-table elevation." },
    "raised": { "$type": "shadow", "$value": "0 2px 6px rgba(5 6 15 / 0.05), 0 20px 44px -20px rgba(26 31 70 / 0.24)", "$description": "Screenshot filmstrip + clinical-report document cards (merged)." },
    "phone": { "$type": "shadow", "$value": "20px 20px 40px rgba(39 40 45 / 0.15)", "$description": "EXCEPTION — cover phone mockups." }
  },

  "zIndex": {
    "below": { "$type": "number", "$value": -1, "$description": "Highlighter swipe behind text." },
    "deco": { "$type": "number", "$value": 0, "$description": "Decorative rings." },
    "base": { "$type": "number", "$value": 1 },
    "raised": { "$type": "number", "$value": 2, "$description": "Front phone, dynamic island, logo tab." }
  },

  "layout": {
    "container": { "$type": "dimension", "$value": "1240px", "$description": "Default content width." },
    "containerNarrow": { "$type": "dimension", "$value": "1080px", "$description": "Text-led sections." },
    "breakpoint": {
      "$description": "3 systemic max-width media queries. Reference only — not Figma-native.",
      "sm": { "$type": "dimension", "$value": "480px" },
      "md": { "$type": "dimension", "$value": "640px" },
      "lg": { "$type": "dimension", "$value": "900px" }
    }
  },

  "decor": {
    "$description": "EXCEPTION — decorative ring / union motif. Ship to Figma as SVG-asset components with corner variants.",
    "ringWidth": { "$type": "dimension", "$value": "325px" },
    "ringHeight": { "$type": "dimension", "$value": "487px" },
    "ringOpacity": { "$type": "number", "$value": 0.32 },
    "unionSize": { "$type": "dimension", "$value": "535px" },
    "unionOpacity": { "$type": "number", "$value": 0.55 }
  }
}
